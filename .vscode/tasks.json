{
    // 校园一卡通 —— VS Code 构建任务
    // 推荐直接用 build.exe（纯 C 构建器，会生成图标并跑单元测试）
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建全部（build.exe）",
            "type": "shell",
            "command": "${workspaceFolder}/build.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "detail": "生成图标 + 编译 server/main/桌面应用 + 跑单元测试"
        },
        {
            "label": "运行: 桌面应用",
            "type": "shell",
            "command": "${workspaceFolder}/校园一卡通.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "运行: 命令行版",
            "type": "shell",
            "command": "${workspaceFolder}/main.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "自检: 桌面应用",
            "type": "shell",
            "command": "gcc -std=c11 -O2 -fexec-charset=UTF-8 launcher.c -o selftest.exe -lcomctl32 -lgdi32 -luser32 -lws2_32 -lshell32 && ./selftest.exe --selftest",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}